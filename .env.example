# Local Next.js development only. For production, use Worker secrets and Hyperdrive.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional comma-separated extra trusted origins
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.workers.dev
